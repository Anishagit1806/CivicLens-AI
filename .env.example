# ==============================================================================
# CivicLens AI Environment Variables
# Copy this file to .env.local and fill in real values before production deploy.
# NEVER commit .env.local or expose service-role / Gemini keys to the browser.
# ==============================================================================

# --- Supabase (Required for Production PostgreSQL + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# Server-only secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# --- Google Gemini AI (Server-only secret) ---
GEMINI_API_KEY=your-gemini-api-key-placeholder
# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Application Security & Runtime ---
# Secret used to sign local/demo session cookies when running without Supabase Auth
# Must be at least 32 random characters in production/staging
CIVICLENS_SESSION_SECRET=replace-with-32-plus-char-random-secret-placeholder

# Set to "true" ONLY in local/evaluation environments without Supabase credentials
# to enable the explicitly badged local file-backed Demo Store & Demo Auth.
# In production on Vercel with Supabase configured, leave this unset or "false".
CIVICLENS_ALLOW_DEMO_MODE=true

# Comma-separated list of admin email addresses automatically recognized as admins
# in demo mode (in Supabase mode, admin role is stored in public.profiles.role).
CIVICLENS_ADMIN_EMAILS=admin@civiclens.local

# Public base URL (used for metadata and callback links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
